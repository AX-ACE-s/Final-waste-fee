# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.  (copy .env.example .env)
# .env 는 저장소에 올리지 않습니다(.gitignore 에 포함). 키는 따옴표로 감싸도 되고, 끝의 = 도 그대로 넣으면 됩니다.
# 비워 둔 항목은 그 기능만 꺼지고 나머지는 정상 동작합니다.
# ─────────────────────────────────────────────────────────────

# 1) 공공데이터포털 인증키 — 전국대형폐기물수거수수료정보표준데이터 (기능③, 정하영)
#    data.go.kr 마이페이지 > 데이터 활용 > 인증키 (일반 인증키, Decoding 값 권장)
#    서버 시작 때 data/fees.csv 를 자동 갱신 / python scripts/fetch_fees.py
DATA_GO_KR_KEY=""

# 2) 법제처 국가법령정보 공동활용 OC (기능③ 조례 별표 링크, 정하영)
#    open.law.go.kr 에 등록한 이메일 아이디 부분(@ 앞) — python scripts/fetch_ordinances.py
LAW_OC=""

# 3) 행정안전부 도로명주소 검색 API 승인키 (기능② 주소검색, 강문정)
#    business.juso.go.kr 에서 발급
JUSO_API_KEY=""

# 4) 사진 인식 AI 키 (기능①, 박상훈) — 없으면 '연습용 가짜 응답'으로 동작(화면에 안내가 뜸)
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-sonnet-4-5"   # 사진 인식에 쓸 모델 (기능① recognition/ai_client.py 가 읽는 이름)

# ── 선택(보통 안 바꿔도 됨) ──────────────────────────────────
# FEE_REFRESH_DAYS=7            # 수수료 데이터 자동 갱신 주기(일). 0이면 매번 새로 받음
# FEE_API_URL="https://api.data.go.kr/openapi/tn_pubr_public_lar_was_fee_api"
# JUSO_API_URL="https://business.juso.go.kr/addrlink/addrLinkApi.do"
